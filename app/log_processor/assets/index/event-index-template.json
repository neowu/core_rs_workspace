{
  "index_patterns": ["event-*"],
  "priority": 1,
  "template": {
    "settings": {
      "number_of_shards": "1",
      "refresh_interval": "10s"
    },
    "mappings": {
      "date_detection": false,
      "dynamic_templates": [
        {
          "context": {
            "path_match": "context.*",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "stats": {
            "path_match": "stats.*",
            "mapping": {
              "type": "scaled_float",
              "scaling_factor": 1000
            }
          }
        },
        {
          "info": {
            "path_match": "info.*",
            "mapping": {
              "type": "text",
              "index": "false"
            }
          }
        }
      ],
      "properties": {
        "@timestamp": {
          "type": "date",
          "format": "strict_date_optional_time"
        },
        "app": {
          "type": "keyword"
        },
        "client_timestamp": {
          "type": "date",
          "format": "strict_date_optional_time"
        },
        "result": {
          "type": "keyword"
        },
        "action": {
          "type": "keyword"
        },
        "error_code": {
          "type": "keyword"
        },
        "error_message": {
          "type": "text",
          "index": "false"
        },
        "elapsed": {
          "type": "long"
        }
      }
    }
  }
}
